# ============================================
# 🌍 WORLDDAY - CONFIGURATION EXAMPLE
# Copy this file to .env and fill in your values
# ============================================

# Required
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=your_email@example.com

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/worldday

# News APIs (fallback chain: NewsAPI → GNews → RSS feeds)
# 1. NewsAPI  — https://newsapi.org/register  (free: 100 req/day)
NEWSAPI_KEY=your_newsapi_key

# 2. GNews    — https://gnews.io              (free: 100 req/day)
GNEWS_API_KEY=your_gnews_key

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Currents API — 600 req/day FREE
# Register: https://currentsapi.services/en/register
CURRENTS_API_KEY=jKFpMpghOygllYPgB9dw28zHubv-Z53oQIQJ1RjoDNQXT1KP

# MediaStack — 500 req/month FREE  
# Register: https://mediastack.com/signup/free
MEDIASTACK_KEY=your_key_here

# TheNewsAPI — 100 req/day FREE
# Register: https://www.thenewsapi.com/register
THENEWSAPI_KEY=your_key_here

# NewsData.io — 200 req/day FREE
# Register: https://newsdata.io/register
NEWSDATA_API_KEY=pub_ecbbc26885ca4c92b0239c766d5b5846

# Knowivate API (Optional - Free, no key needed)
# NOTE: This API may not be publicly available. Leave blank if you don't have access.
# If you have a valid Knowivate API endpoint, uncomment and set it here:
# KNOWIVATE_API_URL=https://news.knowivate.com/api/latest
